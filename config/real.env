# "Real" local stack (ADR 0027): layered on top of config/dev.env by
# `mise run dev:real`. Ops talks to a real S3 implementation (RustFS in docker)
# and ships telemetry to a real Grafana (grafana/otel-lgtm in docker).
# ALL CREDENTIALS HERE ARE LOCAL DEV DUMMIES.

# Separate data dir so ops seeds apply fresh (granary.sqlite + ops.sqlite live here).
GRANARY_DATA_DIR=./data/real

# RustFS (S3 API :9000, console http://localhost:9001/rustfs/console/, login granary-dev / granary-dev-secret)
GRANARY_SEED_S3_ENDPOINT=http://localhost:9000
GRANARY_SEED_S3_REGION=us-east-1
GRANARY_SEED_S3_BUCKET=granary-backups
GRANARY_SEED_S3_ACCESS_KEY_ID=granary-dev
GRANARY_SEED_S3_SECRET_ACCESS_KEY=granary-dev-secret
# Link shown in /ops and /__dev (ADR 0154): the bucket in the RustFS console.
GRANARY_SEED_S3_CONSOLE_URL=http://localhost:9001/rustfs/console/browser/?bucket=granary-backups&key=granary%2F

# More frequent backups so there is something to look at.
GRANARY_SEED_BACKUP_INTERVAL=10m

# Grafana LGTM (UI http://localhost:3300, OTLP/HTTP :4318, no auth locally).
GRANARY_SEED_OTLP_ENDPOINT=http://localhost:4318
GRANARY_SEED_OTLP_AUTH=none
# Link shown in /ops and /__dev (ADR 0154).
GRANARY_SEED_OTLP_GRAFANA_URL=http://localhost:3300/explore

# Login hints shown next to these links in the /__dev Tools card (dev only, dummies).
GRANARY_DEV_LOGIN_HINTS=http://localhost:9001=granary-dev:granary-dev-secret,http://localhost:3300=admin:admin
