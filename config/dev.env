# Development defaults (ADR 0005, names per ADR 0230). FAKE values only —
# never put real secrets here. Production's master key comes from fnox.
ORIGIN=http://localhost:5173
GRANARY_DATA_DIR=./data
GRANARY_DAP_PORT=4711
# GitHub = the fake GitHub; granary connects to it as a GitHub App by itself.
GRANARY_GITHUB_API_URL=http://localhost:4010
GRANARY_GITHUB_WEB_URL=http://localhost:4010
GRANARY_DEV_GITHUB_AUTOCONNECT=1
GRANARY_SEED_ADMINS=admin
# LOADGEN_ALLOWLISTED must match GRANARY_SEED_ALLOWLIST (load generator, ADR 0070).
GRANARY_SEED_ALLOWLIST=alice,carol,dave
FAKE_GITHUB_PORT=4010
LOADGEN_ALLOWLISTED=alice,carol,dave
LOADGEN_PORT=4040
LOADGEN_URL=http://localhost:4040
FAKE_GITHUB_URL=http://localhost:4010
# fake-infra (ADR 0130): fake R2 (S3 under /s3, EU jurisdiction under /s3/eu),
# OTLP receiver (/otlp), exe.dev proxy fronts (token :4091, peer :4092).
# Seeds are FAKE values, re-applied after /__control/reset.
FAKE_INFRA_PORT=4090
FAKE_INFRA_URL=http://localhost:4090
FAKE_INFRA_SEED_BUCKET=granary-backups
FAKE_INFRA_SEED_JURISDICTION=eu
FAKE_INFRA_SEED_ACCESS_KEY_ID=0000000000000000000000000000dev1
FAKE_INFRA_SEED_SECRET_ACCESS_KEY=00000000000000000000000000000000000000000000000000000000fakedev1
FAKE_INFRA_SEED_EXE_TOKEN=exe_fake_dev_token
# ops (ADR 0150): dev seeds pointing the operations module at fake-infra.
# ALL FAKE, DEV ONLY. GRANARY_MASTER_KEY here is a well-known dummy key — never use
# it anywhere real; production's key comes from fnox (profile `prod`).
GRANARY_MASTER_KEY=deadbeefdeadbeefdeadbeefdeadbeefdeadbeefdeadbeefdeadbeefdeadbeef
# R2 destination (EU jurisdiction) → fake R2; keys match FAKE_INFRA_SEED_*.
GRANARY_SEED_R2_ACCOUNT_ID=00000000000000000000000000000000
GRANARY_SEED_R2_JURISDICTION=eu
GRANARY_SEED_R2_BUCKET=granary-backups
GRANARY_SEED_R2_ACCESS_KEY_ID=0000000000000000000000000000dev1
GRANARY_SEED_R2_SECRET_ACCESS_KEY=00000000000000000000000000000000000000000000000000000000fakedev1
GRANARY_SEED_R2_ENDPOINT_OVERRIDE=http://localhost:4090/s3/eu
# Link shown in /ops and /__dev (ADR 0154): fake-infra's page lists buckets and objects.
GRANARY_SEED_R2_CONSOLE_URL=http://localhost:4090/
# OTLP sink → fake-infra's exe.dev proxy token front (stands in for the Grafana VM).
GRANARY_SEED_OTLP_ENDPOINT=http://localhost:4091
GRANARY_SEED_OTLP_AUTH=exe-vm-token
GRANARY_SEED_OTLP_TOKEN=exe_fake_dev_token
