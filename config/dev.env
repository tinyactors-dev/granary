# Development/test defaults (ADR 0005). FAKE values only — never put real
# secrets here. Production values come from fnox (see fnox.toml).
GITHUB_API_URL=http://localhost:4010
GITHUB_WEB_URL=http://localhost:4010
GITHUB_TOKEN=fake-token
GITHUB_WEBHOOK_SECRET=dev-webhook-secret
GITHUB_OAUTH_CLIENT_ID=fake-client
GITHUB_OAUTH_CLIENT_SECRET=fake-secret
ADMINS=admin
ORIGIN=http://localhost:5173
DATABASE_PATH=./data/granary.sqlite
DAP_PORT=4711
FAKE_GITHUB_PORT=4010
FAKE_GITHUB_WEBHOOK_URL=http://localhost:5173/webhook
# Load generator (ADR 0070). LOADGEN_ALLOWLISTED must match ALLOWED_USERS_SEED.
ALLOWED_USERS_SEED=alice,carol,dave
LOADGEN_ALLOWLISTED=alice,carol,dave
LOADGEN_PORT=4040
LOADGEN_URL=http://localhost:4040
FAKE_GITHUB_URL=http://localhost:4010
# fake-infra (ADR 0130): fake R2 (S3 under /s3, EU jurisdiction under /s3/eu),
# OTLP receiver (/otlp), exe.dev proxy fronts (token :4091, peer :4092).
# Seeds are FAKE values, re-applied after /__control/reset.
FAKE_INFRA_PORT=4090
FAKE_INFRA_URL=http://localhost:4090
FAKE_INFRA_SEED_BUCKET=granary-backups
FAKE_INFRA_SEED_JURISDICTION=eu
FAKE_INFRA_SEED_ACCESS_KEY_ID=0000000000000000000000000000dev1
FAKE_INFRA_SEED_SECRET_ACCESS_KEY=00000000000000000000000000000000000000000000000000000000fakedev1
FAKE_INFRA_SEED_EXE_TOKEN=exe_fake_dev_token
# ops (ADR 0150): dev seeds pointing the operations module at fake-infra.
# ALL FAKE, DEV ONLY. OPS_MASTER_KEY here is a well-known dummy key — never use
# it anywhere real; production's key comes from fnox (profile `prod`).
OPS_MASTER_KEY=deadbeefdeadbeefdeadbeefdeadbeefdeadbeefdeadbeefdeadbeefdeadbeef
# R2 destination (EU jurisdiction) → fake R2; keys match FAKE_INFRA_SEED_*.
OPS_SEED_R2_ACCOUNT_ID=00000000000000000000000000000000
OPS_SEED_R2_JURISDICTION=eu
OPS_SEED_R2_BUCKET=granary-backups
OPS_SEED_R2_ACCESS_KEY_ID=0000000000000000000000000000dev1
OPS_SEED_R2_SECRET_ACCESS_KEY=00000000000000000000000000000000000000000000000000000000fakedev1
OPS_SEED_R2_ENDPOINT_OVERRIDE=http://localhost:4090/s3/eu
# Link shown in /ops and /__dev (ADR 0154): fake-infra's page lists buckets and objects.
OPS_SEED_R2_CONSOLE_URL=http://localhost:4090/
# OTLP sink → fake-infra's exe.dev proxy token front (stands in for the Grafana VM).
OPS_SEED_OTLP_ENDPOINT=http://localhost:4091
OPS_SEED_OTLP_AUTH=exe-vm-token
OPS_SEED_OTLP_TOKEN=exe_fake_dev_token
